{
  "name": "@valiprecision/vpx-node-client",
  "version": "1.0.0",
  "description": "VPX Oracle Node — off-chain price aggregator and on-chain pusher for AXIOLEDGER",
  "main": "src/oracle-node.js",
  "scripts": {
    "start":    "node src/oracle-node.js",
    "dev":      "nodemon src/oracle-node.js",
    "lint":     "eslint src/**/*.js",
    "test":     "jest --forceExit --detectOpenHandles",
    "test:ci":  "jest --forceExit --detectOpenHandles --ci --coverage"
  },
  "keywords": ["oracle", "price-feed", "axioledger", "valiprecision", "defi", "web3"],
  "license": "BSL-1.1",
  "dependencies": {
    "axios":      "^1.7.2",
    "dotenv":     "^16.4.5",
    "ethers":     "^6.13.1",
    "node-cron":  "^3.0.3",
    "winston":    "^3.13.0"
  },
  "devDependencies": {
    "eslint":   "^9.7.0",
    "jest":     "^29.7.0",
    "nodemon":  "^3.1.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/src/__tests__/**/*.test.js"],
    "collectCoverageFrom": ["src/**/*.js", "!src/__tests__/**"],
    "coverageThreshold": {
      "global": { "lines": 50 }
    }
  }
}
